# Backend .env.example
# Copy to .env and configure

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./sonoscribe.db

# ── Audio ──
# Sample rate for audio capture (Hz)
AUDIO_SAMPLE_RATE=16000
# Store raw audio files (true/false)
STORE_RAW_AUDIO=false
# Directory for raw audio storage (if enabled)
AUDIO_STORAGE_DIR=./audio_storage

# ── Transcription ──
# Provider: faster-whisper | groq
TRANSCRIPTION_PROVIDER=faster-whisper
# faster-whisper model: tiny.en | base.en | small.en | medium.en | large-v3
FASTER_WHISPER_MODEL=base.en
# faster-whisper compute type: int8 | float16 | float32
FASTER_WHISPER_COMPUTE_TYPE=int8
# faster-whisper device: cpu | cuda
FASTER_WHISPER_DEVICE=cpu

# ── Groq (Cloud Transcription + AI) ──
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# ── AI Notes ──
# Provider: groq | ollama | gemini | none
AI_PROVIDER=none
# Groq AI model (if AI_PROVIDER=groq)
GROQ_AI_MODEL=llama-3.1-70b-versatile
# Ollama (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=info
