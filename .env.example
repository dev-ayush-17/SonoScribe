# ── SonoScribe Environment Variables Configuration ──
# Copy this file to .env before running docker compose or backend services

# ── Database ──
# SQLite or PostgreSQL connection string (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///./sonoscribe.db

# ── Audio ──
# Sample rate for audio capture in Hz
AUDIO_SAMPLE_RATE=16000
# Store raw audio files on disk (true/false)
STORE_RAW_AUDIO=false
# Path to directory for raw audio file storage
AUDIO_STORAGE_DIR=./audio_storage

# ── Transcription ──
# Engine for speech-to-text: faster-whisper (local) or groq (cloud)
TRANSCRIPTION_PROVIDER=faster-whisper
# Local Whisper model size (tiny.en | base.en | small.en | medium.en | large-v3)
FASTER_WHISPER_MODEL=base.en
# Quantization type for faster-whisper (int8 | float16 | float32)
FASTER_WHISPER_COMPUTE_TYPE=int8
# Compute device for faster-whisper (cpu | cuda)
FASTER_WHISPER_DEVICE=cpu

# ── Hugging Face AI Notes ──
# User Access Token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Hugging Face inference model repository ID
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-3B-Instruct

# ── Groq Cloud AI & Speech-to-Text ──
# API key from Groq Console at https://console.groq.com/keys
GROQ_API_KEY=
# Speech-to-Text model on Groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# LLM model ID on Groq for meeting notes synthesis
GROQ_AI_MODEL=llama-3.3-70b-versatile

# ── AI Notes Provider ──
# Active AI engine for notes generation: huggingface | groq | ollama | gemini | none
AI_PROVIDER=huggingface
# Base URL for local Ollama server instance
OLLAMA_BASE_URL=http://localhost:11434
# Local Ollama LLM model tag name
OLLAMA_MODEL=llama3.1
# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Google Gemini model ID
GEMINI_MODEL=gemini-2.0-flash

# ── Server Runtime ──
# Bind interface host address
HOST=0.0.0.0
# Container / service runtime port
PORT=3000
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Logging verbosity level (info | debug | warning | error)
LOG_LEVEL=info
